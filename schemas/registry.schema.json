{
  "$id": "registry.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schemaVersion": "1.0.0",
  "title": "Canonical Service Registry",
  "type": "object",
  "properties": {
    "services": {
      "type": "object",
      "additionalProperties": {
        "$ref": "service.schema.json"
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "anyOf": [
          { "$ref": "package.schema.json" },
          { "$ref": "inquiry.schema.json" }
        ]
      }
    },
    "mappings": {
      "$ref": "mapping.schema.json"
    }
  },
  "required": ["services", "packages", "mappings"],
  "additionalProperties": false
}

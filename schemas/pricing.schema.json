{
  "$id": "pricing.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schemaVersion": "1.0.0",
  "title": "Pricing Definition",
  "type": "object",
  "properties": {
    "currency": {
      "type": "string",
      "enum": ["ZAR", "USD", "EUR"]
    },
    "price": {
      "type": "number",
      "minimum": 0
    },
    "subtotal": {
      "type": "number",
      "minimum": 0
    },
    "vat": {
      "type": "number",
      "minimum": 0
    },
    "total": {
      "type": "number",
      "minimum": 0
    },
    "lineItems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "amount": { "type": "number", "minimum": 0 }
        },
        "required": ["description", "amount"],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": ["currency", "price", "subtotal", "vat", "total"],
  "additionalProperties": false
}

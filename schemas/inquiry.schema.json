{
  "$id": "inquiry.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schemaVersion": "1.0.0",
  "title": "Inquiry Package Definition",
  "type": "object",
  "properties": {
    "productCode": {
      "type": "string",
      "pattern": "^INQ-[A-Z0-9]+$"
    },
    "serviceId": {
      "type": "null"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "packageTier": {
      "type": ["string", "null"],
      "enum": ["basic", "standard", "premium", null]
    },
    "coverageType": {
      "type": ["string", "null"]
    },
    "features": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 0
    },
    "frontendLabels": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "entityType": {
      "type": "string",
      "const": "inquiry"
    },
    "workflowType": {
      "type": "string",
      "minLength": 1
    },
    "billable": {
      "type": "boolean",
      "const": false
    },
    "requiresManualScoping": {
      "type": "boolean",
      "const": true
    },
    "deprecated": {
      "type": "boolean"
    },
    "deprecatedReason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "productCode",
    "displayName",
    "frontendLabels",
    "entityType",
    "workflowType",
    "billable",
    "requiresManualScoping"
  ],
  "additionalProperties": false
}

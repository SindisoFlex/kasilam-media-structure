{
  "$id": "audit.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schemaVersion": "1.0.0",
  "title": "Audit Event Definition",
  "type": "object",
  "properties": {
    "eventType": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "detail": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": ["eventType", "timestamp"],
  "additionalProperties": false
}
